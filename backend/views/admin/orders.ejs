<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Orders</title>
</head>
<body>
<% orders.forEach(order => { %>

<%
let progress = 10;

if(order.status === "PLACED") progress = 20;
else if(order.status === "PACKED") progress = 40;
else if(order.status === "SHIPPED") progress = 60;
else if(order.status === "OUT_FOR_DELIVERY") progress = 80;
else if(order.status === "DELIVERED") progress = 100;
%>

<div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-6 mb-8 hover:shadow-xl transition">

    <!-- HEADER -->
     <div class="flex justify-between items-start">

    <div class="flex gap-4 items-center">

        <img
            src="<%= order.items[0].product?.image %>"
            class="w-20 h-20 rounded-xl object-cover border shadow">

        <div>

           

            <h2 class="text-2xl font-bold text-gray-800">
    <%= order.items[0].product?.name %>
</h2>

<p class="text-gray-500">
    <% order.items.forEach(item => { %>
        <%= item.product ? item.product.name : (item.name || "Product not found") %>
    <% }) %>
</p>

<td>
<pre><%= JSON.stringify(order.items, null, 2) %></pre>
</td>   

        </div>

    </div>
  
</div>

    <div class="flex flex-col md:flex-row justify-between gap-4">

        <div>


            <p class="text-gray-500 mt-1">
                Current Status
            </p>

            <span class="
            inline-block
            mt-2
            px-4
            py-2
            rounded-full
            text-sm
            font-semibold

            <%= order.status==='DELIVERED'
            ? 'bg-green-100 text-green-700'
            : order.status==='SHIPPED'
            ? 'bg-blue-100 text-blue-700'
            : order.status==='PACKED'
            ? 'bg-yellow-100 text-yellow-700'
            : 'bg-gray-100 text-gray-700' %>">

                <%= order.status %>

            </span>

        </div>

        <div>

            <button
            onclick="openModal('<%= order._id %>')"
            class="bg-black text-white px-6 py-3 rounded-xl hover:bg-gray-800">

                Update Order

            </button>

        </div>

    </div>

    <!-- TRACKING BAR -->

    <div class="mt-8">

        <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden">

            <div
            class="bg-green-500 h-3 transition-all duration-700"
            style="width:<%= progress %>%">

            </div>

        </div>

        <div class="flex justify-between mt-4 text-xs md:text-sm text-gray-600">

            <span>📦 Placed</span>
            <span>📦 Packed</span>
            <span>🚚 Shipped</span>
            <span>🛵 Out</span>
            <span>🎉 Delivered</span>

        </div>

    </div>

    <!-- TRACKING LOCATION -->

    <div class="mt-6">

        <div class="bg-gray-50 rounded-2xl p-5 border">

            <h4 class="font-bold text-gray-700 mb-2">
                📍 Latest Tracking Update
            </h4>

            <p class="text-gray-600">

                <%= order.trackingLocation || 'No tracking updates available' %>

            </p>

        </div>

    </div>

</div>

<!-- MODAL -->

<div
id="modal-<%= order._id %>"
class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">

    <div class="bg-white rounded-3xl w-full max-w-2xl p-8">

        <div class="flex justify-between items-center mb-6">

            <h2 class="text-2xl font-bold">
                Manage Order
            </h2>

            <button
            onclick="closeModal('<%= order._id %>')"
            class="text-3xl font-bold">

                ×

            </button>

        </div>

        <form
        action="/owners/admin/order/<%= order._id %>/update"
        method="POST">

            <!-- STATUS -->

            <label class="block font-semibold mb-2">

                Order Status

            </label>

            <select
            name="status"
            class="w-full border rounded-xl p-3 mb-5">

                <option value="PLACED">Placed</option>
                <option value="PACKED">Packed</option>
                <option value="SHIPPED">Shipped</option>
                <option value="OUT_FOR_DELIVERY">Out For Delivery</option>
                <option value="DELIVERED">Delivered</option>
                <option value="REJECTED">Rejected</option>

            </select>

            <!-- LOCATION -->

            <label class="block font-semibold mb-2">

                Tracking Location

            </label>

            <input
            type="text"
            name="trackingLocation"
            value="<%= order.trackingLocation || '' %>"
            placeholder="Mumbai Hub"
            class="w-full border rounded-xl p-3 mb-5">

            <!-- SAVE -->

            <button
            type="submit"
            class="w-full bg-black text-white py-4 rounded-xl font-bold hover:bg-gray-800">

                Save Changes

            </button>

        </form>

    </div>

</div>

<% }) %>
<script>
function openModal(id) {
    document.getElementById(`modal-${id}`).classList.remove('hidden');
}

function closeModal(id) {
    document.getElementById(`modal-${id}`).classList.add('hidden');
}
</script>

</body>
</html>
